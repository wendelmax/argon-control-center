# Maintainer: wendelmax <https://github.com/wendelmax>
pkgname=argon-control-center
_reponame=argon-control-center
pkgver=0.3.0
pkgrel=1
pkgdesc="Raspberry Pi & Argon40 hardware control center (fan curve, telemetry, overclocking, GPIO lab)"
# The AUR requires x86_64 support; it builds from source there (monitoring only).
# Release binaries are published for 64-bit ARM only.
arch=('aarch64' 'armv7h' 'x86_64')
url="https://github.com/wendelmax/argon-control-center"
license=('MIT')
depends=('gcc-libs' 'glibc' 'libglvnd' 'libxkbcommon' 'wayland' 'libx11' 'systemd')
makedepends=('cargo')
optdepends=('polkit: write system files and control argononed from the GUI'
            'i2c-tools: I2C scan in the GPIO lab'
            'libgpiod: GPIO tools'
            'raspberrypi-utils: GPU clocks and throttling flags (vcgencmd)')
install=argon-control-center.install
# No separate -debug package in the release assets.
options=('!debug')
source=("$_reponame-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
# Replaced with the checksum of the release tarball by packaging/arch/aur-publish.sh.
sha256sums=('SKIP')

prepare() {
  cd "$_reponame-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_reponame-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$_reponame-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen
}

package() {
  cd "$_reponame-$pkgver"
  sh packaging/common/install-tree.sh "$pkgdir" target/release/$pkgname
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
